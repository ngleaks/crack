local FruitInjector = {
    Tools = {},
    Items = {},
}

function FruitInjector.IsJunk(inst)
    if inst:IsA("Script")
        or inst:IsA("LocalScript")
        or inst:IsA("ModuleScript") then
        return true
    end

    if inst:IsA("Weld")
        or inst:IsA("WeldConstraint")
        or inst:IsA("Motor6D") then
        return true
    end

    if inst:IsA("BodyMover")
        or inst:IsA("Constraint") then
        return true
    end

    if inst:IsA("Sound")
        or inst:IsA("Animation")
        or inst:IsA("AnimationController")
        or inst:IsA("Animator") then
        return true
    end

    return false
end

function FruitInjector.FindFruitModel(container)
    if not container then
        return nil
    end

    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Tool")
            and not FruitInjector.Tools[child]
            and child:FindFirstChild("Handle") then

            local m =
                child:FindFirstChild("Fruit")
                or child:FindFirstChildWhichIsA("Model")

            if m then
                return m
            end
        end
    end

    return nil
end

function FruitInjector.GetModel(fruitName)
    local built = ModelBuilder.Build(fruitName)

    if built then
        return built:Clone()
    end

    local cacheFolder =
        ReplicatedStorage:FindFirstChild(
            "MemeFakeFruits"
        )

    if cacheFolder then
        local cached =
            cacheFolder:FindFirstChild(fruitName)

        if cached then
            return cached:Clone()
        end
    end

    local backpack =
        LocalPlayer:FindFirstChild("Backpack")

    local existing =
        FruitInjector.FindFruitModel(backpack)
        or FruitInjector.FindFruitModel(
            LocalPlayer.Character
        )

    if existing then
        return existing:Clone()
    end

    return nil
end

function FruitInjector.Attach(model, handle)
    for _, desc in ipairs(model:GetDescendants()) do
        if FruitInjector.IsJunk(desc) then
            desc:Destroy()
        end
    end

    model:PivotTo(handle.CFrame)

    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.Anchored = false
            desc.CanCollide = false
            desc.CanTouch = false
            desc.CanQuery = false
            desc.Massless = true

            local weld =
                Instance.new("WeldConstraint")

            weld.Part0 = handle
            weld.Part1 = desc
            weld.Parent = desc
        end
    end
end

function FruitInjector.GiveTool(fruitEntry)
    local displayName =
        fruitEntry[4] .. " Fruit"

    local assetUrl =
        "rbxassetid://" ..
        tostring(fruitEntry[3])

    local tool =
        Instance.new("Tool")

    tool.Name = displayName
    tool.ToolTip = displayName
    tool.TextureId = assetUrl
    tool.CanBeDropped = false
    tool.RequiresHandle = true
    tool.Grip = CFrame.new(0, -0.2, 0)

    tool:SetAttribute(
        "FruitTool",
        true
    )

    local handle =
        Instance.new("Part")

    handle.Name = "Handle"
    handle.Size = Vector3.new(1, 1, 1)
    handle.Transparency = 1
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool

    local model =
        FruitInjector.GetModel(
            fruitEntry[1]
        )

    if model then
        model.Name = "Fruit"
        model.Parent = tool

        FruitInjector.Attach(
            model,
            handle
        )
    else
        handle.Transparency = 0
        handle.Color =
            Color3.fromRGB(
                170,
                85,
                255
            )
        handle.Material =
            Enum.Material.Neon
    end

    local bp =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )

    if bp then
        tool.Parent = bp
        FruitInjector.Tools[tool] = true
    else
        tool:Destroy()
    end
end

function FruitInjector.GiveInv(fruitEntry)
    pcall(function()
        local invCtrl =
            require(
                ReplicatedStorage
                    .Controllers
                    .UI
                    .Inventory
            )

        local item = {
            Name = fruitEntry[1],
            Count = 1,
            Mastery = 0,

            MasteryRequirements = {
                X = 1,
                Z = 1,
            },

            Rarity = fruitEntry[2],
            Type = "Blox Fruit",
            Value = 2000,

            Texture =
                "rbxassetid://" ..
                tostring(fruitEntry[3]),

            DisplayName =
                fruitEntry[4] ..
                " Fruit",
        }

        table.insert(
            FruitInjector.Items,
            item
        )

        local list =
            invCtrl:GetInventory()

        table.insert(
            list,
            item
        )

        if invCtrl.Reflow then
            invCtrl:Reflow()

        elseif invCtrl.Update then
            invCtrl:Update()
        end
    end)
end

function FruitInjector.Give(fruitEntry)
    if Config.Backpack then
        FruitInjector.GiveTool(
            fruitEntry
        )
    end

    if Config.Inventory then
        FruitInjector.GiveInv(
            fruitEntry
        )
    end
end

function FruitInjector.Clear()
    for tool in pairs(
        FruitInjector.Tools
    ) do
        if tool and tool.Parent then
            tool:Destroy()
        end
    end

    FruitInjector.Tools = {}

    pcall(function()
        local invCtrl =
            require(
                ReplicatedStorage
                    .Controllers
                    .UI
                    .Inventory
            )

        local list =
            invCtrl:GetInventory()

        for _, fakeItem in ipairs(
            FruitInjector.Items
        ) do
            local idx =
                table.find(
                    list,
                    fakeItem
                )

            if idx then
                table.remove(
                    list,
                    idx
                )
            end
        end

        FruitInjector.Items = {}

        if invCtrl.Reflow then
            invCtrl:Reflow()

        elseif invCtrl.Update then
            invCtrl:Update()
        end
    end)
end

