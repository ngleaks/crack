function GachaSpinner.GetHandler()
    if not getconnections then
        return nil
    end

    local modules =
        ReplicatedStorage:FindFirstChild(
            "Modules"
        )

    local net =
        modules
        and modules:FindFirstChild(
            "Net"
        )

    local remote =
        net
        and net:FindFirstChild(
            "RE/SpinGacha"
        )

    if not remote then
        return nil
    end

    for _, conn in ipairs(
        getconnections(
            remote.OnClientEvent
        )
    ) do
        if conn.Function then
            return conn.Function
        end
    end

    return nil
end

function GachaSpinner.Spin(targetFruit)
    if GachaSpinner.Spinning then
        return
    end

    local entry =
        FruitDB.Find(
            targetFruit
            or Config.Fruit
        )

    if not entry then
        return
    end

    GachaSpinner.Spinning = true

    pcall(function()
        local handler =
            GachaSpinner.GetHandler()

        if handler then
            handler(
                "GachaWindow",
                "SummerGacha",
                entry[1]
            )
        else
            local spinner =
                require(
                    ReplicatedStorage
                        .Controllers
                        .UI
                        .Spinner
                )

            spinner.StartSpin(
                "GachaWindow",
                GachaSpinner.Pool,
                entry[1]
            )
        end
    end)

    task.wait(6.8)

    FruitInjector.Give(entry)

    GachaSpinner.Spinning = false
end

