-- MODEL BUILDER
--==================================================

local ModelBuilder = {
    Data = nil,
    File = "FakeGachaModels.json",
    Url = nil,
}

function ModelBuilder.Load()
    if ModelBuilder.Data then
        return ModelBuilder.Data
    end

    if isfile and isfile(ModelBuilder.File) then
        local ok, res = pcall(function()
            return HttpService:JSONDecode(
                readfile(ModelBuilder.File)
            )
        end)

        if ok and res then
            ModelBuilder.Data = res
            return res
        end
    end

    return nil
end

function ModelBuilder.MakePart(spec)
    local p = Instance.new("Part")

    p.Name = spec.Name or "Part"

    local ok, mesh = pcall(function()
        return game:GetObjects(spec.MeshId)[1]
    end)

    if ok and mesh then
        if mesh:IsA("MeshPart") then
            p:Destroy()
            p = mesh

        else
            local found = mesh:FindFirstChildWhichIsA(
                "MeshPart",
                true
            )

            if found then
                p:Destroy()
                p = found:Clone()
            end

            mesh:Destroy()
        end
    end

    for k, v in pairs(spec.Props or {}) do
        if not PropDecoder.Ignore[k] then
            PropDecoder.Set(p, k, v)
        end
    end

    return p
end

function ModelBuilder.AddEmitters(parent, emitters)
    for _, emSpec in ipairs(emitters or {}) do
        local emitter = Instance.new("ParticleEmitter")

        for k, v in pairs(emSpec.Props or {}) do
            PropDecoder.Set(emitter, k, v)
        end

        local targetParent = parent

        if emSpec.Offset then
            local att = Instance.new("Attachment")

            att.CFrame = PropDecoder.Decode(
                emSpec.Offset
            )

            att.Parent = parent
            targetParent = att
        end

        emitter.Parent = targetParent
    end
end

function ModelBuilder.Build(fruitName)
    local data = ModelBuilder.Load()

    local spec = data and data[fruitName]

    if not spec then
        return nil
    end

    local model = Instance.new("Model")

    model.Name = "Fruit"

    local rootPart = nil

    for _, partSpec in ipairs(spec.Parts or {}) do
        local part = ModelBuilder.MakePart(partSpec)

        if partSpec.Offset then
            part.CFrame = PropDecoder.Decode(
                partSpec.Offset
            )
        else
            rootPart = part
        end

        part.Parent = model

        ModelBuilder.AddEmitters(
            part,
            partSpec.Emitters
        )
    end

    for _, childSpec in ipairs(spec.Children or {}) do
        local inst = Instance.new(childSpec.Class)

        inst.Name =
            childSpec.Name or childSpec.Class

        for k, v in pairs(childSpec.Props or {}) do
            PropDecoder.Set(
                inst,
                k,
                v
            )
        end

        inst.Parent = model
    end

    if rootPart then
        model.PrimaryPart = rootPart
    end

    return model
end

