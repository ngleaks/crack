--==================================================
-- PROPERTY DECODER
--==================================================

local PropDecoder = {
    Ignore = {
        CFrame = true,
        WorldPivot = true,
        Position = true,
        Orientation = true,
        Rotation = true,
    },
}

function PropDecoder.Decode(val)
    if type(val) ~= "table" then
        return val
    end

    local t = val._t

    if t == "V3" then
        return Vector3.new(val.x, val.y, val.z)

    elseif t == "CF" then
        return CFrame.new(unpack(val.c))

    elseif t == "C3" then
        return Color3.new(val.r, val.g, val.b)

    elseif t == "BC" then
        return BrickColor.new(val.n)

    elseif t == "E" then
        local ok, enumVal = pcall(function()
            return Enum[val.e][val.v]
        end)

        return ok and enumVal or nil

    elseif t == "NR" then
        return NumberRange.new(val.min, val.max)

    elseif t == "V2" then
        return Vector2.new(val.x, val.y)

    elseif t == "NS" then
        local kps = {}

        for _, kp in ipairs(val.k) do
            table.insert(
                kps,
                NumberSequenceKeypoint.new(
                    kp.t,
                    kp.v,
                    kp.e or 0
                )
            )
        end

        return NumberSequence.new(kps)

    elseif t == "CS" then
        local kps = {}

        for _, kp in ipairs(val.k) do
            table.insert(
                kps,
                ColorSequenceKeypoint.new(
                    kp.t,
                    Color3.new(kp.r, kp.g, kp.b)
                )
            )
        end

        return ColorSequence.new(kps)
    end

    return val
end

function PropDecoder.Set(inst, prop, rawVal)
    local decoded = PropDecoder.Decode(rawVal)

    if decoded ~= nil then
        pcall(function()
            inst[prop] = decoded
        end)
    end
end

